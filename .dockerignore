# Used when the frontend image is built with the repository root as context.
# Backend and MCP images keep their own context directories and ignore files.
# `backend` is intentionally NOT ignored so the repo-root backend Dockerfile
# (used for single-service Render deployments) can COPY backend sources.

.git
.github
.cursor
mcp
docs
observability
assets
**/node_modules
**/.next
**/coverage
**/.venv
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.env
**/.env.*
!**/.env.example
**/.DS_Store
**/dist
**/*.tsbuildinfo
